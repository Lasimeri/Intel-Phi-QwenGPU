	  -T$(GSRC)/vx.ld -o $@ $(GENV)/crt0.S src/guest/stories_bridge.c $(GUEST)/wrom_vx.c $(GSRC)/exit_xp.c \
	  -Wl,--start-group -lc -lgcc -Wl,--end-group
