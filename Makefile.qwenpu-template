$(OUT)/q35_bridge_verify: tests/text/q35_bridge_verify.cc $(OUT)/bridge.o $(OUT)/q35_ref.o $(RV_OBJ) $(TEXT_OBJ) $(TEXT_HDR) src/text/q35.h src/text/vocab.h
	$(CXX) $(REFFLAGS) -o $@ tests/text/q35_bridge_verify.cc $(OUT)/bridge.o $(OUT)/q35_ref.o $(RV_OBJ) $(TEXT_OBJ)
